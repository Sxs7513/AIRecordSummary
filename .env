# Versioned project defaults. Put machine-local secrets in .env.local.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=sxs
DB_PASSWORD=930329
DB_NAME=airecord
DB_ADMIN_DATABASE=postgres
DB_SSL=false

# Storage
LOCAL_STORAGE_ROOT=uploads
COMPUTE_WORKER_BASE_URL=http://127.0.0.1:8010/internal/v1/compute
COMPUTE_WORKER_HOST=127.0.0.1
COMPUTE_WORKER_PORT=8010
COMPUTE_WORKER_INTERNAL_TOKEN=local-compute-worker
ASR_LAB_PROJECT_DATASET_ROOT=datasets/asr-encrypted

# Runtime
AUDIO_DEPS_AUTO_INSTALL=true
AUDIO_MODEL_CACHE_ROOT=model-cache

# ASR
ASR_PROVIDER=qwen_asr
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_LANGUAGE=auto
QWEN_ASR_CONTEXT_CONFIG=config/initial-prompt.json
QWEN_ASR_CONTEXT=
QWEN_ASR_MAX_CONTEXT_ITEMS=200
QWEN_ASR_MAX_INFERENCE_BATCH_SIZE=1
QWEN_ASR_NUM_BEAMS=2
QWEN_ASR_TEMPO=1
QWEN_ASR_ENHANCE_LOW_VOLUME_SEGMENTS=true
QWEN_ASR_LOW_VOLUME_RMS_THRESHOLD=0.01
QWEN_ASR_LOW_VOLUME_PEAK_THRESHOLD=0.08
QWEN_ASR_LOW_VOLUME_MAX_GAIN_DB=9
FUNASR_NANO_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
ASR_AUDIO_PREPROCESSING_ENABLED=true
ASR_SPEECH_WINDOW_TARGET_DURATION_MS=30000
ASR_SPEECH_WINDOW_MAX_DURATION_MS=80000
ASR_SPEECH_WINDOW_OVERLAP_MS=500
ASR_WINDOW_CORRECTION_MAX_EDIT_RATIO=0.35
TRANSCRIPT_ALIGNMENT_ENABLED=true
TRANSCRIPT_ALIGNMENT_MODEL=Qwen/Qwen3-ForcedAligner-0.6B

# Speaker diarization
PYANNOTE_AUTH_TOKEN=
PYANNOTE_USE_LOCAL_CONFIG=true
PYANNOTE_SEGMENT_MERGE_MAX_GAP_MS=86400000
PYANNOTE_SEGMENT_MERGE_MAX_DURATION_MS=80000
PYANNOTE_SHORT_SEGMENT_ABSORB_MAX_DURATION_MS=2000
PYANNOTE_SHORT_SEGMENT_ABSORB_MAX_GAP_MS=2000

# Text correction
LLM_DEFAULT_PROVIDER=gemini
# TRANSCRIPTION_CORRECTION_ENABLED=true  # pycorrector 暂时停用
WHISPER_INITIAL_PROMPT_CONFIG=config/initial-prompt.json
LLM_CORRECTION_ENABLED=true
LOCAL_LLM_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
LOCAL_LLM_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf,qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf
LLM_CORRECTION_CONTEXT_SIZE=8192
TEXT_CORRECTION_BATCH_MAX_UNITS=16
TEXT_CORRECTION_BATCH_MAX_CHARS=4000
ZHIPU_MODEL=glm-4.5-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TIMEOUT_SECONDS=120
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=5
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TIMEOUT_SECONDS=300
QWEN_LLM_MODEL=qwen3.8-flash
QWEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_TIMEOUT_SECONDS=300

# Indexing and RAG
RAG_ONLINE_DEFAULT_MODEL=gemini-gemini-3.5-flash-lite
SEARCH_CHUNK_TOPIC_DETECTION_ENABLED=true
SEARCH_CHUNK_MAX_TOKEN=512
SEARCH_CHUNK_MAX_DURATION_MS=180000
SEARCH_CHUNK_MAX_UTTERANCES=30
RAG_CHUNK_CONTEXT_WINDOW_UTTERANCES=1
RAG_HYBRID_SEARCH_ENABLED=true
RAG_VECTOR_CANDIDATE_LIMIT=30
RAG_LEXICAL_CANDIDATE_LIMIT=30
RAG_FUSED_CANDIDATE_LIMIT=20
RAG_RRF_K=60
RAG_ORIGINAL_VECTOR_WEIGHT=0.7
RAG_EXPANDED_VECTOR_WEIGHT=0.2
RAG_LEXICAL_WEIGHT=0.1
RAG_RECORDING_PROFILE_SEARCH_ENABLED=true
RAG_RECORDING_PROFILE_CANDIDATE_LIMIT=3
RAG_RECORDING_PROFILE_MIN_SCORE=0.30
RAG_RECORDING_PROFILE_SCOPED_CHUNK_LIMIT=2
# default 使用 LOCAL_LLM_MODEL_*（当前 7B）；rag 使用 RAG_LOCAL_MODEL_*（当前 4B）
RAG_ROUTE_MODEL_PROFILE=default
RAG_NODE_MODEL_PROFILE=default
RAG_ASR_ADJUDICATION_ENABLED=true
RAG_ASR_ADJUDICATION_WEB_SEARCH_ENABLED=true
RAG_ASR_ADJUDICATION_AUTO_RESOLVE_CONFIDENCE=0.8
RAG_ASR_ADJUDICATION_SEARCH_PROVIDER=chrome_ai_overview
RAG_ASR_ADJUDICATION_SEARCH_MODEL=gemini-2.5-flash-lite
RAG_ASR_ADJUDICATION_CHROME_AIO_TIMEOUT_SECONDS=45
RAG_ASR_ADJUDICATION_CHROME_AIO_POLL_INTERVAL_SECONDS=1
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RAG_RUN_MAX_TOTAL_TOKENS=500000
RAG_ASR_ADJUDICATION_AUDIT_PROMPT_VARIANT=free_discovery
# RAG_ASR_ADJUDICATION_AUDIT_MODEL=qwen-qwen3.8-max
# RAG_ASR_ADJUDICATION_AUDIT_MODEL=qwen-deepseek-v4-flash
RAG_ASR_ADJUDICATION_AUDIT_MODEL=gemini-gemini-3.7-flash
RAG_ASR_ADJUDICATION_CONSTRUCT_MODEL=gemini-gemini-3.5-flash-lite
RAG_ASR_ADJUDICATION_DECISION_MODEL=gemini-gemini-3.5-flash-lite
RAG_ASR_ADJUDICATION_AUDIT_MIN_REQUEST_INTERVAL_SECONDS=15

# Summary
RECORDING_SUMMARY_ROLLING_ENABLED=false
RECORDING_SUMMARY_CONTEXT_SIZE=65536
RECORDING_SUMMARY_EMBEDDING_MAX_TOKENS=512
LOCAL_LLM_VERBOSE=false

# ASR Lab
ASR_LAB_TRAINING_PYTHON_BIN=backend/packages/l2_core/trainers/qwen-asr-lora/.venv/bin/python
ASR_LAB_TRAINING_MODULE=qwen_asr_lora
ASR_LAB_TRAINING_MODEL=Qwen/Qwen3-ASR-1.7B-hf
QWEN_ASR_TRAINER_BOOTSTRAP_PYTHON=python3.12
ASR_LAB_WORKER_POLL_SECONDS=10
NEXT_PUBLIC_EVALUATION_API_ORIGIN=http://localhost:8001
NEXT_PUBLIC_TRAINING_API_ORIGIN=http://localhost:8002

# Bootstrap account
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=12345678
BOOTSTRAP_WORKSPACE_NAME=test
