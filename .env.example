DB_HOST=localhost
DB_PORT=5432
DB_USER=sxs
DB_PASSWORD=930329
DB_NAME=airecord
DB_ADMIN_DATABASE=postgres
DB_SSL=false
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_record_summary
LOCAL_STORAGE_ROOT=uploads
PUBLIC_FILE_BASE_URL=
# 是否在应用启动时运行 scripts/install_audio_dependencies.sh。
AUDIO_DEPS_INSTALL_ON_STARTUP=true
# 安装脚本内部是否自动检查/安装音频依赖。
AUDIO_DEPS_AUTO_INSTALL=true
WHISPER_PYTHON_BIN=.venv-audio/bin/python
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=
WHISPER_INITIAL_PROMPT_CONFIG=config/initial-prompt.json
TRANSCRIPTION_CORRECTION_ENABLED=true
LLM_CORRECTION_ENABLED=true
LLM_CORRECTION_PYTHON_BIN=.venv-audio/bin/python
LLM_CORRECTION_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct-GGUF
LLM_CORRECTION_MODEL_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf,qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf
LLM_CORRECTION_CONTEXT_SIZE=8192
LLM_CORRECTION_TIMEOUT_MS=600000
PYANNOTE_PYTHON_BIN=.venv-audio/bin/python
PYANNOTE_AUTH_TOKEN=
# 是否优先消费本地 pyannote pipeline config；设为 false 时走标准 HuggingFace 加载。
PYANNOTE_USE_LOCAL_CONFIG=true
SPEECHBRAIN_PYTHON_BIN=.venv-audio/bin/python
AUDIO_MODEL_CACHE_ROOT=model-cache
TARGET_SPEAKER_THRESHOLD=0.7
UTTERANCE_MAX_DURATION_MS=30000
UTTERANCE_MAX_TEXT_CHARS=500
UTTERANCE_LLM_MERGE_MAX_GAP_MS=1200
UTTERANCE_LLM_MERGE_MAX_DURATION_MS=60000
UTTERANCE_LLM_MERGE_MAX_TEXT_CHARS=300
EMBEDDED_WORKER_ENABLED=true
EMBEDDED_WORKER_CONCURRENCY=2
EMBEDDED_WORKER_INTERVAL_MS=5000
EMBEDDED_WORKER_BATCH_SIZE=25
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560
EMBEDDING_MODEL_CACHE_DIR=model-cache/embedding
ASR_PROVIDER=qwen_asr
HF_WHISPER_PYTHON_BIN=.venv-audio/bin/python
HF_WHISPER_MODEL=BELLE-2/Belle-whisper-large-v3-turbo-zh
HF_WHISPER_LANGUAGE=zh
HF_WHISPER_CHUNK_LENGTH_S=30
HF_WHISPER_BATCH_SIZE=4
HF_WHISPER_VAD_MODEL=fsmn-vad
HF_WHISPER_VAD_MAX_SEGMENT_MS=30000
HF_WHISPER_MERGE_VAD=true
HF_WHISPER_MERGE_LENGTH_S=15
QWEN_ASR_PYTHON_BIN=.venv-audio/bin/python
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ASR_LANGUAGE=auto
QWEN_ASR_FORCED_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
QWEN_ASR_USE_OWN_SEGMENTS=false
QWEN_ASR_CONTEXT_CONFIG=config/initial-prompt.json
QWEN_ASR_CONTEXT=
QWEN_ASR_MAX_CONTEXT_ITEMS=500
QWEN_ASR_MAX_NEW_TOKENS=4096
QWEN_ASR_MAX_INFERENCE_BATCH_SIZE=4
QWEN_ASR_ENHANCE_LOW_VOLUME_SEGMENTS=true
QWEN_ASR_LOW_VOLUME_RMS_THRESHOLD=0.015
QWEN_ASR_LOW_VOLUME_PEAK_THRESHOLD=0.12
QWEN_ASR_VAD_MODEL=fsmn-vad
QWEN_ASR_VAD_MAX_SEGMENT_MS=30000
QWEN_ASR_MERGE_VAD=true
QWEN_ASR_MERGE_LENGTH_S=15
SENSEVOICE_PYTHON_BIN=.venv-audio/bin/python
SENSEVOICE_MODEL=FunAudioLLM/SenseVoiceSmall
SENSEVOICE_LANGUAGE=auto
SENSEVOICE_USE_ITN=true
SENSEVOICE_VAD_MODEL=fsmn-vad
SENSEVOICE_VAD_MAX_SEGMENT_MS=30000
SENSEVOICE_MERGE_VAD=true
SENSEVOICE_MERGE_LENGTH_S=15
PARAFORMER_PYTHON_BIN=.venv-audio/bin/python
PARAFORMER_MODEL=paraformer-zh
PARAFORMER_MODEL_REVISION=v2.0.4
PARAFORMER_VAD_MODEL=fsmn-vad
PARAFORMER_VAD_MODEL_REVISION=v2.0.4
PARAFORMER_PUNC_MODEL=ct-punc-c
PARAFORMER_PUNC_MODEL_REVISION=v2.0.4
PARAFORMER_HOTWORD_CONFIG=config/initial-prompt.json
PARAFORMER_MAX_HOTWORDS=200
PARAFORMER_VAD_MAX_SEGMENT_MS=30000
PARAFORMER_MERGE_VAD=true
PARAFORMER_MERGE_LENGTH_S=15
RECORDING_SUMMARY_PROVIDER=local_llm
RECORDING_SUMMARY_PROMPT_CONFIG=config/initial-prompt.json
# 录音总结上下文窗口大小。Qwen3.5-9B 原生支持 262K，上下文越大内存占用越高。
RECORDING_SUMMARY_CONTEXT_SIZE=262144
RECORDING_SUMMARY_MAX_TOKENS=4096
# 是否对长录音启用滚动记忆式分段总结；设为 false 时会尽量把完整文本放进长上下文。
RECORDING_SUMMARY_ROLLING_ENABLED=true
RECORDING_SUMMARY_ROLLING_THRESHOLD_MS=1800000
RECORDING_SUMMARY_ROLLING_CHUNK_DURATION_MS=600000
RECORDING_SUMMARY_ROLLING_CHUNK_MAX_CHARS=8000
RECORDING_SUMMARY_ROLLING_CHUNK_MAX_TOKENS=1800
RECORDING_SUMMARY_ROLLING_MEMORY_MAX_CHARS=6000
RECORDING_SUMMARY_TIMEOUT_MS=0
# 向量命中后，向前/向后扩展多少毫秒作为问答证据上下文。
SEARCH_EVIDENCE_CONTEXT_BEFORE_MS=60000
SEARCH_EVIDENCE_CONTEXT_AFTER_MS=60000
# 单条问答证据最多拼接多少字符。
SEARCH_EVIDENCE_CONTEXT_MAX_CHARS=1600
# 同一录音内相邻证据窗口间隔小于该值时合并，单位毫秒。
SEARCH_EVIDENCE_MERGE_GAP_MS=30000
LOCAL_LLM_MODEL_REPO=DevQuasar/Qwen.Qwen3.5-9B-GGUF
LOCAL_LLM_MODEL_FILE=Qwen.Qwen3.5-9B.Q8_0.gguf
