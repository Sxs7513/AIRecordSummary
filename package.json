{
  "name": "ai-record-summary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "infra:up": "docker-compose up -d --wait && npm run infra:init",
    "infra:init": "cd backend && PYTHONPATH=packages .venv/bin/python scripts/initialize_kafka.py",
    "infra:rebuild-redis": "cd backend && PYTHONPATH=packages .venv/bin/python scripts/rebuild_redis_state.py",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs -f kafka redis",
    "dev": "next dev -H 127.0.0.1",
    "dev:python-web": "npm run dev:production-api",
    "dev:production-api": "cd backend && PYTHONPATH=packages .venv/bin/uvicorn main:app --app-dir packages/l3_app/production-api --reload --no-access-log --port 8000",
    "dev:compute-worker": "cd backend && PYTHONPATH=packages .venv/bin/uvicorn main:app --app-dir packages/l3_app/compute_worker --reload --no-access-log --port 8010",
    "dev:observability-worker": "cd backend && PYTHONPATH=packages:packages/l3_app/observability-api .venv/bin/python -m l3_app.observability_worker.main",
    "dev:generation-worker": "cd backend && PYTHONPATH=packages .venv/bin/python -m l3_app.generation_worker.main",
    "dev:processing-worker": "cd backend && PYTHONPATH=packages .venv/bin/python -m l3_app.processing_worker.main",
    "dev:observability-api": "cd backend && PYTHONPATH=packages:packages/l3_app/observability-api .venv/bin/uvicorn main:app --app-dir packages/l3_app/observability-api --reload --no-access-log --port 8003",
    "dev:evaluation-api": "cd backend && PYTHONPATH=packages .venv/bin/uvicorn main:app --app-dir packages/l3_app/evaluation-api --reload --no-access-log --port 8001",
    "dev:rag-evaluation-worker": "cd backend && PYTHONPATH=packages .venv/bin/python -m l3_app.rag_evaluation_worker.main",
    "dev:training-api": "cd backend && PYTHONPATH=packages .venv/bin/uvicorn main:app --app-dir packages/l3_app/training-api --reload --no-access-log --port 8002",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "db:init": "sh scripts/db/init-python-backend.sh",
    "db:init:evaluation": "sh scripts/db/init-evaluation.sh",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@types/pg": "^8.11.11",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
